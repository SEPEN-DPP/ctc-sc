rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Provisorio: banco fechado para todos ate as regras por perfil (etapa 5)
    // serem escritas e testadas no emulador. Nada le nem grava enquanto isso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
